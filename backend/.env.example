# Existing required backend settings
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/nexor_orders?sslmode=require"
JWT_SECRET="replace-with-a-long-random-secret"
PORT=3000
CORS_ORIGIN="*"

# Gemini (server-side only; never put this key in Flutter or the website widget)
GEMINI_API_KEY="your-gemini-api-key"
GEMINI_MODEL="gemini-3.1-flash-lite"
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"

# Public URL of this NestJS API, including /api/v1.
# The Website Chat embed code is built from this value.
PUBLIC_API_BASE_URL="https://api.example.com/api/v1"
LOCAL_DEMO_API_BASE_URL="http://localhost:3000/api/v1"

# Required only for Instagram / Facebook Messenger OAuth and Webhooks
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI="https://api.example.com/api/v1/conversations/oauth/callback"
META_WEBHOOK_VERIFY_TOKEN=""
META_TOKEN_ENCRYPTION_KEY=""
